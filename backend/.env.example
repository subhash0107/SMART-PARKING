# ============================================
# Smart Parking Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in actual values

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Database Configuration
# ============================================
# MongoDB Atlas Connection:
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/smartparking
# 
# Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/smartparking
MONGODB_URI=mongodb://localhost:27017/smartparking

# ============================================
# JWT Configuration
# ============================================
# Generate a strong secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-jwt-secret-key-for-production-change-this
JWT_EXPIRE=30d

# ============================================
# Razorpay Payment Gateway (India)
# ============================================
# Sign up at https://dashboard.razorpay.com/
# Get Key ID and Secret from Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_SECRET=your_razorpay_secret_key

# ============================================
# Email Service (Optional)
# ============================================
# For Gmail: Enable 2FA, create App Password
# For SendGrid: Get API key, create sender verified email
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=Smart Parking <noreply@smartparking.com>

# ============================================
# Logging & Debugging
# ============================================
LOG_LEVEL=debug
DEBUG_MODE=true

# ============================================
# CORS Configuration
# ============================================
# Frontend URLs allowed to access this API
FRONTEND_URL=http://localhost:3000
ADMIN_PORTAL_URL=http://localhost:3001

# ============================================
# Third-party Services
# ============================================
# For SMS notifications (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# For file uploads (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET=smart-parking-uploads

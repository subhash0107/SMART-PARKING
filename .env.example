# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in the actual values

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Database Configuration
# ============================================
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/smartparking
# Local MongoDB: mongodb://localhost:27017/smartparking
MONGODB_URI=mongodb://localhost:27017/smartparking

# ============================================
# JWT Configuration
# ============================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# ============================================
# Razorpay Configuration (Indian Payment Gateway)
# ============================================
# Get from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXX
RAZORPAY_SECRET=XXXXXXXXXXXXXXXXXX

# ============================================
# Email Configuration (Optional - for notifications)
# ============================================
# Using Gmail: Enable 2FA and use App Password
# Using SendGrid: Get API key from sendgrid.com
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@smartparking.com

# ============================================
# Admin Configuration
# ============================================
ADMIN_EMAIL=admin@smartparking.com
ADMIN_PASSWORD=change-this-password

# ============================================
# Frontend Configuration
# ============================================
REACT_APP_API_URL=http://localhost:5000
REACT_APP_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXX
